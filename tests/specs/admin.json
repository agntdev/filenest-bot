[
  {
    "name": "/admin",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Admin access hasn't been configured yet."
            }
          }
        ],
        "send": {
          "text": "/admin"
        }
      }
    ]
  },
  {
    "name": "non-admin broadcast callbacks are rejected",
    "steps": [
      {
        "send": {
          "callback": "admin:broadcast",
          "userId": 99
        },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "This feature is for admins only."
            }
          }
        ]
      }
    ]
  }
]
